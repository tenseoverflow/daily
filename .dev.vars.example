# Äripäev Ä-konto — https://iseteenindus.aripaev.ee/et/login
ARIPAEV_EMAIL=you@example.com
ARIPAEV_PASSWORD=replace-me

# Delfi (Piano ID) — open login from https://www.delfi.ee/klient/konto
DELFI_EMAIL=you@example.com
DELFI_PASSWORD=replace-me

# AI: workers | ollama | auto
# For local --local wrangler, use ollama (Workers AI needs remote):
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional site lock
DIGEST_ACCESS_TOKEN=optional-long-random-string
