{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daily",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily_digest",
      "database_id": "ae8f8de3-41b4-475e-90b1-daa87c1cfb23",
      "preview_database_id": "local-daily-digest"
    }
  ],
  "triggers": {
    // 06:00 UTC ≈ 09:00 Europe/Tallinn during EEST (summer)
    "crons": ["0 6 * * *"]
  },
  "vars": {
    "TIMEZONE": "Europe/Tallinn",
    "DIGEST_HOUR": "9",
    "TOP_HEADLINES": "8",
    "MAX_FEED_ITEMS": "40",
    // workers | cursor | auto (auto = Workers → Cursor)
    "AI_PROVIDER": "auto",
    "CURSOR_API_BASE_URL": "https://api.cursor.com"
    // Optional: set CURSOR_MODEL in .dev.vars / vars to pin a model id from GET /v1/models.
    // When omitted, Cursor uses your account/team default.
  }
}
